  )
  (global $global_desc (ref (exact $point.desc)) (struct.new $point.desc (i32.const 42)))
  (global $global_point (ref (exact $point)) (struct.new_default_desc $point (global.get $global_desc)))
  (func (export "descriptor") (result (ref (exact $point.desc)))
