;; `array.fill`: a store loop with a null trap and a range trap, over a runtime length.
(module
  (type $a (array (mut i32)))
  (type $b (array (mut i8)))
  (func (export "fill_all") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new_default $a (i32.const 4)))
    ;; Operand order is (array, offset, value, count).
    (array.fill $a (local.get $arr) (i32.const 0) (i32.const 7) (i32.const 4))
    (i32.add (array.get $a (local.get $arr) (i32.const 0))
             (array.get $a (local.get $arr) (i32.const 3))))
  (func (export "fill_partial") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new $a (i32.const 1) (i32.const 4)))
    (array.fill $a (local.get $arr) (i32.const 1) (i32.const 9) (i32.const 2))
    (i32.add (array.get $a (local.get $arr) (i32.const 1))
             (array.get $a (local.get $arr) (i32.const 3))))
  (func (export "fill_zero_len") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new $a (i32.const 5) (i32.const 2)))
    (array.fill $a (local.get $arr) (i32.const 2) (i32.const 99) (i32.const 0))
    (array.get $a (local.get $arr) (i32.const 1)))
  (func (export "fill_at_end") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new_default $a (i32.const 3)))
    (array.fill $a (local.get $arr) (i32.const 2) (i32.const 3) (i32.const 1))
    (array.get $a (local.get $arr) (i32.const 2)))
  (func (export "fill_oob") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new_default $a (i32.const 4)))
    (array.fill $a (local.get $arr) (i32.const 3) (i32.const 1) (i32.const 2))
    (i32.const 0))
  (func (export "fill_null") (result i32)
    (array.fill $a (ref.null $a) (i32.const 0) (i32.const 1) (i32.const 1))
    (i32.const 0))
  (func (export "fill_packed") (result i32)
    (local $arr (ref $b))
    (local.set $arr (array.new_default $b (i32.const 3)))
    (array.fill $b (local.get $arr) (i32.const 0) (i32.const 300) (i32.const 3))
    (array.get_u $b (local.get $arr) (i32.const 2))))
