;; A map is lowered as a list of canonical key/value pairs.
(component
  (core module $m
    (memory (export "memory") 1)
    (func (export "echo") (param i32 i32) (result i32)
      (i32.store (i32.const 2048) (local.get 0))
      (i32.store (i32.const 2052) (local.get 1))
      (i32.const 2048)
    )
    (func (export "realloc") (param i32 i32 i32 i32) (result i32)
      (i32.const 1024)
    )
  )
  (core instance $i (instantiate $m))
  (alias core export $i "echo" (core func $echo))
  (alias core export $i "realloc" (core func $realloc))
  (alias core export $i "memory" (core memory $mem))
  (type $map (map u32 u32))
  (export $map2 "map" (type $map))
  (type $ft (func (param "m" $map2) (result $map2)))
  (canon lift (core func $echo) (memory $mem) (realloc $realloc)
    (func $f (type $ft)))
  (export "echo" (func $f))
)
