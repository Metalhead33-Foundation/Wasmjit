;; `array.new_data` copies a data segment into a fresh array.
(module
  (type $a (array (mut i8)))
  (type $b (array (mut i32)))
  (data $d "\01\02\03\04\05\06\07\08")
  (func (export "data_i8") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new_data $a $d (i32.const 2) (i32.const 4)))
    (array.get_u $a (local.get $arr) (i32.const 0)))
  (func (export "data_i8_last") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new_data $a $d (i32.const 2) (i32.const 4)))
    (array.get_u $a (local.get $arr) (i32.const 3)))
  (func (export "data_i32") (result i32)
    (local $arr (ref $b))
    (local.set $arr (array.new_data $b $d (i32.const 0) (i32.const 2)))
    (array.get $b (local.get $arr) (i32.const 0)))
  (func (export "data_len") (result i32)
    (array.len (array.new_data $a $d (i32.const 0) (i32.const 5))))
  (func (export "data_zero") (result i32)
    (array.len (array.new_data $a $d (i32.const 8) (i32.const 0))))
  (func (export "data_oob") (result i32)
    (drop (array.new_data $a $d (i32.const 6) (i32.const 4)))
    (i32.const 0)))
