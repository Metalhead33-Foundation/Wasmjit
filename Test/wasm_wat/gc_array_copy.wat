;; `array.copy` implements the memmove rule: the direction depends on where the
;; regions sit, and both of these fixtures give a different answer if it is wrong.
(module
  (type $a (array (mut i32)))
  (type $b (array (mut i8)))
  (func (export "copy_down") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new_fixed $a 4 (i32.const 0) (i32.const 1) (i32.const 2) (i32.const 3)))
    (array.copy $a $a (local.get $arr) (i32.const 0) (local.get $arr) (i32.const 1) (i32.const 3))
    (i32.add (i32.mul (array.get $a (local.get $arr) (i32.const 0)) (i32.const 100))
             (array.get $a (local.get $arr) (i32.const 2))))
  (func (export "copy_up") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new_fixed $a 4 (i32.const 0) (i32.const 1) (i32.const 2) (i32.const 3)))
    (array.copy $a $a (local.get $arr) (i32.const 1) (local.get $arr) (i32.const 0) (i32.const 3))
    (i32.add (i32.mul (array.get $a (local.get $arr) (i32.const 1)) (i32.const 100))
             (array.get $a (local.get $arr) (i32.const 3))))
  (func (export "copy_distinct") (result i32)
    (local $dst (ref $a))
    (local $src (ref $a))
    (local.set $src (array.new_fixed $a 2 (i32.const 7) (i32.const 8)))
    (local.set $dst (array.new_default $a (i32.const 2)))
    (array.copy $a $a (local.get $dst) (i32.const 0) (local.get $src) (i32.const 0) (i32.const 2))
    (i32.add (i32.mul (array.get $a (local.get $dst) (i32.const 0)) (i32.const 10))
             (array.get $a (local.get $dst) (i32.const 1))))
  (func (export "copy_zero") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new $a (i32.const 4) (i32.const 2)))
    (array.copy $a $a (local.get $arr) (i32.const 0) (local.get $arr) (i32.const 0) (i32.const 0))
    (array.get $a (local.get $arr) (i32.const 1)))
  (func (export "copy_packed") (result i32)
    (local $dst (ref $b))
    (local $src (ref $b))
    (local.set $src (array.new $b (i32.const 5) (i32.const 2)))
    (local.set $dst (array.new_default $b (i32.const 2)))
    (array.copy $b $b (local.get $dst) (i32.const 0) (local.get $src) (i32.const 0) (i32.const 2))
    (array.get_u $b (local.get $dst) (i32.const 1)))
  (func (export "copy_dst_oob") (result i32)
    (local $arr (ref $a))
    (local.set $arr (array.new_default $a (i32.const 2)))
    (array.copy $a $a (local.get $arr) (i32.const 1) (local.get $arr) (i32.const 0) (i32.const 2))
    (i32.const 0))
  (func (export "copy_src_oob") (result i32)
    (local $dst (ref $a))
    (local $src (ref $a))
    (local.set $src (array.new_default $a (i32.const 2)))
    (local.set $dst (array.new_default $a (i32.const 4)))
    (array.copy $a $a (local.get $dst) (i32.const 0) (local.get $src) (i32.const 1) (i32.const 2))
    (i32.const 0))
  (func (export "copy_null") (result i32)
    (local $src (ref $a))
    (local.set $src (array.new_default $a (i32.const 2)))
    (array.copy $a $a (ref.null $a) (i32.const 0) (local.get $src) (i32.const 0) (i32.const 1))
    (i32.const 0)))
